{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/options-general.php?page=weave-rybbit-analytics",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Rybbit Analytics Demo",
				"timezone_string": "Pacific/Auckland",
				"permalink_structure": "/%postname%/",
				"date_format": "j F Y",
				"WPLANG": "en_NZ"
			}
		},
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		}
	]
}
